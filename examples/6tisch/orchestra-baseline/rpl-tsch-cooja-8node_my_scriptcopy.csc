  <plugin>
    org.contikios.cooja.plugins.ScriptRunner
    <plugin_config>
      <script>TIMEOUT(3600000); /* 45 minutes -- stock Orchestra baseline, same topology as implicit-ack-tree comparison */
log.log("Dumping every mote log line for up to 45 minutes of simulated time\n");
while(true) {
  YIELD();
  log.log("t=" + time + " id=" + id + ": " + msg + "\n");
}</script>
      <active>true</active>
    </plugin_config>
  </plugin>
